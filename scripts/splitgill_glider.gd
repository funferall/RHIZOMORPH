extends RefCounted
## Splitgill Glider, the Morel Hollow's flying spore bomber: two split-gill (Schizophyllum) fans
## spread as wings from a pitted morel body, a rust streamer for a tail, and earthball spore bombs
## slung underneath. The art is built in Blender by tools/blender/glider_build.py and baked onto
## three low-poly meshes sharing one 1024 atlas. One opaque surface and one draw call.
##
## Its motion was generated by UniMate (text-to-motion for any skeleton) on the glider's 14-bone
## rig, then baked by tools/unimate/glider_motion.py into a small bone texture: the shader skins
## the mesh on the GPU, so there is no Skeleton3D or AnimationPlayer per unit. Three clips: a
## glide (at rest), a wingbeat (flying, sped up with `gait`), and a bomb run (on `strike`) that
## drops the bombs at its release; they grow back on their cords as it pulls up.

const SHADER := preload("res://shaders/splitgill_glider.gdshader")
const SCENES := [
	preload("res://art/glider/glider_close.glb"),
	preload("res://art/glider/glider_battle.glb"),
	preload("res://art/glider/glider_distant.glb"),
]
const ALBEDO := preload("res://art/glider/glider_albedo.png")
const NORMAL := preload("res://art/glider/glider_normal.png")
const ORM := preload("res://art/glider/glider_orm.png")
const BONES := preload("res://art/glider/glider_bones.tres")
const LOD_NAMES := ["close", "battle", "distant"]
const LOD_SIZE := 2.3       # wingspan (m), for on-screen detail choice
const HEIGHT := 1.8
const SWING_SECONDS := 1.2  # the bomb run; matches SWING_SECONDS in the motion include
const WINDUP_SECONDS := 0.71184   # = RELEASE in the motion include * SWING_SECONDS: the bombs let go
const MUZZLE := Vector3(0.0, 0.95, 0.0)   # the bombs hang here
static var _meshes := {}
static var _material: ShaderMaterial


static func material() -> ShaderMaterial:
	if _material == null:
		_material = ShaderMaterial.new()
		_material.shader = SHADER
		_material.set_shader_parameter("albedo_map", ALBEDO)
		_material.set_shader_parameter("normal_map", NORMAL)
		_material.set_shader_parameter("orm_map", ORM)
		_material.set_shader_parameter("bones", BONES)
	return _material


static func mesh(lod := 0) -> ArrayMesh:
	lod = clampi(lod, 0, 2)
	if not _meshes.has(lod):
		var root: Node = SCENES[lod].instantiate()
		var mi: MeshInstance3D = root.find_children("*", "MeshInstance3D", true, false)[0]
		var m := ArrayMesh.new()
		m.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, mi.mesh.surface_get_arrays(0))
		root.free()
		m.resource_name = "Glider_" + LOD_NAMES[lod]
		m.surface_set_material(0, material())
		m.custom_aabb = m.get_aabb().grow(0.9)   # wingbeats, the dive and falling bombs reach out
		_meshes[lod] = m
	return _meshes[lod]


static func stats(lod: int) -> Dictionary:
	var m := mesh(lod)
	return {"lod": LOD_NAMES[lod], "triangles": m.surface_get_array_index_len(0) / 3,
		"vertices": m.surface_get_array_len(0), "surfaces": m.get_surface_count()}


static func choose_lod(pixels: float, current: int) -> int:
	if current == 0:
		return 1 if pixels < 80.0 else 0
	if current == 2:
		return 1 if pixels > 26.0 else 2
	if pixels > 96.0:
		return 0
	return 2 if pixels < 20.0 else 1
