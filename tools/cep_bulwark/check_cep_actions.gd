extends SceneTree
const Actions := preload("res://scripts/cep_actions.gd")

func _initialize() -> void:
	var a := Actions.new()
	var impacts := [0]
	a.bash_impact.connect(func(): impacts[0] += 1)
	assert(a.attack())
	assert(not a.attack(), "No overlapping melee attacks")
	a.advance(0.49)
	assert(impacts[0] == 1)
	a.advance(1.0)
	assert(impacts[0] == 1 and a.bash == -1.0)
	a.toggle_brace()
	a.advance(0.99)
	assert(not a.capture_active(), "No protection before roots finish sinking")
	a.advance(0.02)
	assert(a.capture_active() and a.brace == 1.0)
	assert(a.capture_damage(100.0) == 25.0)
	assert(a.capture_damage(100.0,false) == 100.0)
	assert(not a.attack(), "Cannot bash while rooted")
	a.move()
	assert(not a.capture_active())
	a.advance(0.40)
	assert(a.state == Actions.State.UPROOTING and a.brace > 0.0)
	a.advance(0.50)
	assert(a.state == Actions.State.WALK and a.brace == 0.0)
	assert(a.capture_damage(100.0) == 100.0)
	assert(is_equal_approx(Actions.entry_fraction(Vector3(5,1,0),Vector3(-5,1,0),Vector3.ZERO),0.2))
	assert(Actions.entry_fraction(Vector3(5,1,4),Vector3(-5,1,4),Vector3.ZERO) == -1.0)
	assert(Actions.entry_fraction(Vector3.ZERO,Vector3.ZERO,Vector3.ZERO) == 0.0)
	assert(Actions.entry_fraction(Vector3(5,1,0),Vector3(5,1,0),Vector3.ZERO) == -1.0)
	print("CEP ACTION CHECKS PASSED: single impact, root/attack locks, 25% capture, uproot-before-move, swept interception")
	quit()
